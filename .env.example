# Flask Environment Configuration
FLASK_APP=wsgi.py
FLASK_ENV=development
DEBUG=True

# Application Secret Key (Generate a random 32+ character hex string in production)
# e.g. python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# PostgreSQL Database Configuration
# Option 1: Full Database URL (Standard on Render / Heroku / Supabase / Neon)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/balaji_fleet_db

# Option 2: Individual Connection Parameters (used if DATABASE_URL is not set)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=balaji_fleet_db

# File Upload Settings
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=instance/uploads

# Active Challan Data Provider: surepass | masters_india | manual
CHALLAN_DATA_PROVIDER=surepass

# Surepass Vehicle RC and Challan API (external.balajitransports.in)
SUREPASS_CHALLAN_API_URL=https://external.balajitransports.in/api/SurepassvehicleRcdetails/GetVehicleRCChallanData
SUREPASS_RC_API_URL=https://external.balajitransports.in/api/SurepassvehicleRcdetails/GetVehicleRcDetails

# Production Security Flags
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
